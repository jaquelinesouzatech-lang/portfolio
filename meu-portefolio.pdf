<script>
(function(){
  "use strict";

  /* ============ EDIT YOUR LINKS HERE ============
     Paste your full profile URLs between the quotes.
     Empty links stay visible but inactive until you add them. */
  var LINKS = {
    linkedin: "https://www.linkedin.com/in/jaquesouzatech",
    email:    "jaquelinesouza.tech@gmail.com"
  };

  var $  = function(s,r){return (r||document).querySelector(s)};
  var $$ = function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};

  /* ---------- contact links ---------- */
  function setLink(id,url,mail){
    var a=$(id); if(!a) return;
    if(url){
      a.href = mail ? "mailto:"+url : url;
      if(!mail){a.target="_blank";a.rel="noopener noreferrer";}
    } else {
      a.setAttribute("aria-disabled","true");
      a.title="Add this link in the LINKS block at the bottom of index.html";
      a.addEventListener("click",function(e){e.preventDefault();});
    }
  }
  setLink("#lnkLinkedin",LINKS.linkedin,false);
  setLink("#lnkEmail",LINKS.email,true);
  /* email: opens the mail app and also copies the address (helps when a mail app is not configured) */
  var toast=$("#toast"), tt;
  function say(m){toast.textContent=m;toast.classList.add("show");clearTimeout(tt);tt=setTimeout(function(){toast.classList.remove("show");},2600);}
  $("#lnkEmail").addEventListener("click",function(){
    try{ if(navigator.clipboard) navigator.clipboard.writeText(LINKS.email).then(function(){say("Email address copied");}); }catch(e){}
  });

  /* ---------- nav ---------- */
  var nav=$("#nav"), burger=$("#burger"), mm=$("#mmenu");
  function onScroll(){nav.classList.toggle("scrolled",window.scrollY>24);}
  onScroll(); window.addEventListener("scroll",onScroll,{passive:true});
  function setMenu(open){
    mm.classList.toggle("open",open);
    mm.setAttribute("aria-hidden",open?"false":"true");
    burger.setAttribute("aria-expanded",open?"true":"false");
    burger.setAttribute("aria-label",open?"Close menu":"Open menu");
    document.body.style.overflow=open?"hidden":"";
  }
  burger.addEventListener("click",function(){setMenu(!mm.classList.contains("open"));});
  $$("#mmenu a").forEach(function(a){a.addEventListener("click",function(){setMenu(false);});});
  window.addEventListener("resize",function(){if(window.innerWidth>900) setMenu(false);});

  /* smooth in-page scrolling for all internal nav/CTA links (avoids full navigation) */
  function goTo(id){
    var target=document.getElementById(id);
    if(target) target.scrollIntoView({behavior:"smooth",block:"start"});
  }
  $$('[data-scroll]').forEach(function(a){
    a.addEventListener("click",function(e){
      e.preventDefault();
      goTo(a.getAttribute("data-scroll"));
    });
    a.addEventListener("keydown",function(e){
      if(e.key==="Enter"||e.key===" "){
        e.preventDefault();
        goTo(a.getAttribute("data-scroll"));
      }
    });
  });

  /* active link */
  var links=$$(".nav-links a"), secs=["home","projects","skills","about","experience","contact"].map(function(id){return document.getElementById(id);});
  if("IntersectionObserver" in window){
    var so=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){
          links.forEach(function(l){l.classList.toggle("active",l.getAttribute("data-scroll")===e.target.id);});
        }
      });
    },{rootMargin:"-45% 0px -50% 0px"});
    secs.forEach(function(s){s&&so.observe(s);});
  }

  /* ---------- reveal ---------- */
  var rv=$$(".rv");
  if("IntersectionObserver" in window){
    var ro=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");ro.unobserve(e.target);}});
    },{threshold:.08,rootMargin:"0px 0px -6% 0px"});
    rv.forEach(function(el){ro.observe(el);});
  } else { rv.forEach(function(el){el.classList.add("in");}); }

  /* ---------- hero art: waveform + reticle ---------- */
  (function(){
    var NS="http://www.w3.org/2000/svg", cx=270, cy=270;
    var ticks=$("#hTicks");
    for(var i=0;i<120;i++){
      var a=i/120*Math.PI*2, long=i%5===0, r1=208, r2=long?222:215;
      var l=document.createElementNS(NS,"line");
      l.setAttribute("x1",(cx+Math.cos(a)*r1).toFixed(1));l.setAttribute("y1",(cy+Math.sin(a)*r1).toFixed(1));
      l.setAttribute("x2",(cx+Math.cos(a)*r2).toFixed(1));l.setAttribute("y2",(cy+Math.sin(a)*r2).toFixed(1));
      l.setAttribute("stroke-width",long?"1":".7");
      ticks.appendChild(l);
    }
    var segs=[[80,168,"S1"],[182,300,"S2"],[314,372,"S1"],[386,462,"S2"]];
    var seed=11; function rnd(){seed=(seed*16807)%2147483647;return (seed-1)/2147483646;}
    var d="M64 270", x=64, up=true;
    while(x<476){
      var amp=1.4, sg=null;
      for(var k=0;k<segs.length;k++){ if(x>=segs[k][0]&&x<=segs[k][1]) sg=segs[k]; }
      if(sg){
        var t=(x-sg[0])/(sg[1]-sg[0]);
        var env=Math.pow(Math.sin(Math.PI*t),.6);
        amp=(10+rnd()*54)*env+3;
      }
      x+=3.2;
      d+=" L"+x.toFixed(1)+" "+(cy+(up?-amp:amp)).toFixed(1);
      up=!up;
    }
    var w=$("#hWave"); w.setAttribute("d",d);
    w.style.setProperty("--len",Math.ceil(w.getTotalLength())+20);
    var b=$("#hBounds"), lb=$("#hLabels"), edges=[];
    segs.forEach(function(s,i){
      edges.push(s[0]-7); if(i===segs.length-1) edges.push(s[1]+7);
      var t=document.createElementNS(NS,"text");
      t.setAttribute("x",(s[0]+s[1])/2);t.setAttribute("y",212);t.setAttribute("text-anchor","middle");t.setAttribute("letter-spacing","1.5");
      t.textContent=s[2]; lb.appendChild(t);
    });
    edges.forEach(function(ex){
      var l=document.createElementNS(NS,"line");
      l.setAttribute("x1",ex);l.setAttribute("x2",ex);l.setAttribute("y1",222);l.setAttribute("y2",318);
      l.setAttribute("stroke","#cfb88e");l.setAttribute("stroke-opacity",".55");l.setAttribute("stroke-dasharray","3 4");
      b.appendChild(l);
    });
  })();

  /* ---------- project 1: criteria explorer ---------- */
  var CRIT=[
    {n:"Instruction Following",a:["FAIL","f","Drops the soccer framing after one line and never adapts to a child audience."],b:["PASS","p","Builds the whole answer around a soccer ball and speaks to a 10-year-old."]},
    {n:"Accuracy",a:["PARTIAL","m","Technically correct, but the analogy it attempts (“probabilistic ball position”) is misleading."],b:["PASS","p","Simplified, yet consistent with how superposition is commonly explained. It also avoids implying quantum computers are better at everything."]},
    {n:"Relevance",a:["FAIL","f","Most of the answer is terminology the reader cannot use."],b:["PASS","p","Every sentence supports the requested explanation."]},
    {n:"Completeness",a:["FAIL","f","The metaphor starts and stops, with no clear takeaway."],b:["PASS","p","Covers what a quantum bit is, how it differs and why it is useful."]},
    {n:"Language Quality",a:["FAIL","f","Academic register and long sentences for a child."],b:["PASS","p","Short sentences, plain words and a friendly tone."]}
  ];
  var tabs=$("#critTabs"), out=$("#critOut");
  function showCrit(i){
    $$("button",tabs).forEach(function(b,j){b.setAttribute("aria-selected",j===i?"true":"false");});
    var c=CRIT[i];
    out.innerHTML =
      '<div><b>Model A <span class="r '+c.a[1]+'">'+c.a[0]+'</span></b>'+c.a[2]+'</div>'+
      '<div><b>Model B <span class="r '+c.b[1]+'">'+c.b[0]+'</span></b>'+c.b[2]+'</div>';
  }
  CRIT.forEach(function(c,i){
    var b=document.createElement("button");b.type="button";b.setAttribute("role","tab");b.textContent=c.n;
    b.addEventListener("click",function(){showCrit(i);});tabs.appendChild(b);
  });
  showCrit(0);

  /* ---------- project 2: speech phenomena ---------- */
  var EX=[
    {w:"SPEAKER 1",raw:"“I-I-I think we should go tomorrow.”",clean:"“I think we should go tomorrow.”",tag:"STUTTER / REPETITION"},
    {w:"SPEAKER 2",raw:"“Yeah, um, I think that works.”",clean:"“Yeah, I think that works.”",tag:"FILLER / HESITATION"},
    {w:"SPEAKER 1",raw:"“I was going to— actually, never mind.”",clean:"“Actually, never mind.”",tag:"FALSE START / SELF-CORRECTION"},
    {w:"SPEAKER 2",raw:"“Wait, I—”",clean:"“Wait.”",tag:"INTERRUPTED SPEECH"}
  ];
  var exl=$("#exList"), tgK=$("#tgKeep"), tgC=$("#tgClean");
  function renderEx(keep){
    tgK.setAttribute("aria-pressed",keep?"true":"false");
    tgC.setAttribute("aria-pressed",keep?"false":"true");
    exl.innerHTML=EX.map(function(e){
      return '<div class="ex"><div class="who">'+e.w+'</div><div class="q">'+(keep?e.raw:e.clean)+'</div>'+
        (keep?'<span class="chip">'+e.tag+'</span>':'<span class="chip none">✕ '+e.tag.toLowerCase()+' lost</span>')+'</div>';
    }).join("");
  }
  tgK.addEventListener("click",function(){renderEx(true);});
  tgC.addEventListener("click",function(){renderEx(false);});
  renderEx(true);

  /* ---------- project 2: lightbox ---------- */
  var lb=$("#lb"), lbImg=$("#lbImg"), lbStage=$("#lbStage"), lbT=$("#lbTitle"), lbC=$("#lbCap"), lbSize=$("#lbSize");
  var items=$$(".wf-btn").map(function(btn){
    var fig=btn.closest("figure");
    return {btn:btn,src:$("img",btn).src,alt:$("img",btn).alt,title:$("b",fig).textContent,cap:$("span",fig.querySelector("figcaption")).textContent};
  });
  var cur=0, lastFocus=null;
  function show(i){
    cur=(i+items.length)%items.length; var it=items[cur];
    lbImg.src=it.src; lbImg.alt=it.alt; lbT.textContent=it.title; lbC.textContent=it.cap;
  }
  function openLb(i){
    lastFocus=document.activeElement; show(i); setActual(window.innerWidth<720);
    lb.classList.add("open"); lb.setAttribute("aria-hidden","false"); document.body.style.overflow="hidden";
    $("#lbClose").focus();
  }
  function closeLb(){
    lb.classList.remove("open"); lb.setAttribute("aria-hidden","true"); document.body.style.overflow="";
    setActual(false); if(lastFocus) lastFocus.focus();
  }
  function setActual(on){lbStage.classList.toggle("actual",on);lbSize.setAttribute("aria-pressed",on?"true":"false");lbSize.textContent=on?"Fit to screen":"Actual size";}
  items.forEach(function(it,i){it.btn.addEventListener("click",function(){openLb(i);});});
  $("#lbClose").addEventListener("click",closeLb);
  $("#lbPrev").addEventListener("click",function(){show(cur-1);});
  $("#lbNext").addEventListener("click",function(){show(cur+1);});
  lbSize.addEventListener("click",function(){setActual(!lbStage.classList.contains("actual"));});
  lb.addEventListener("click",function(e){if(e.target===lb||e.target===lbStage) closeLb();});
  document.addEventListener("keydown",function(e){
    if(!lb.classList.contains("open")) return;
    if(e.key==="Escape") closeLb();
    else if(e.key==="ArrowLeft") show(cur-1);
    else if(e.key==="ArrowRight") show(cur+1);
    else if(e.key==="Tab"){
      var f=$$("button",lb), first=f[0], last=f[f.length-1];
      if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
      else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
    }
  });

  /* ---------- project 4: defect highlight ---------- */
  function hl(d,on){
    $$('[data-d="'+d+'"]').forEach(function(el){
      if(el.classList.contains("ov-ring")||el.classList.contains("co")) el.classList.toggle(el.classList.contains("co")?"on":"on",on);
    });
  }
  $$(".defects li, .co").forEach(function(el){
    var d=el.getAttribute("data-d");
    el.addEventListener("mouseenter",function(){hl(d,true);});
    el.addEventListener("mouseleave",function(){hl(d,false);});
  });
})();
</script>
</body>
</html>
